diff --git a/core/src/gl/host_gles1.cpp b/core/src/gl/host_gles1.cpp
new file mode 100644
index 0000000..c754789
--- /dev/null
+++ b/core/src/gl/host_gles1.cpp
@@ -0,0 +1,128 @@
+#include "zb/host_gles1.h"
+
+#include <EGL/egl.h>
+#include <GLES/gl.h>
+#include <GLES/glext.h>
+#include <dlfcn.h>
+
+#include <bit>
+#include <cstring>
+
+#include "zb/log.h"
+#include "zb/runtime_report.h"
+
+namespace zb {
+
+namespace {
+
+void* const kMissing = reinterpret_cast<void*>(std::uintptr_t{1});
+constexpr GLenum kArrayBufferBinding = 0x8894;  // GL_ARRAY_BUFFER_BINDING (GLES 1.1)
+
+void* gles1_library() {
+    static void* handle = ::dlopen("libGLESv1_CM.so", RTLD_NOW | RTLD_LOCAL);
+    return handle;
+}
+
+// Resolved once from the real libGLESv1_CM.so; zbridge itself links only GLES 2/3.
+template <typename Fn>
+Fn gles1_fn(const char* name) {
+    void* handle = gles1_library();
+    void* address = handle != nullptr ? ::dlsym(handle, name) : nullptr;
+    return reinterpret_cast<Fn>(address);
+}
+
+}  // namespace
+
+// The arguments of one guest call: r0-r3, then the guest stack, as AAPCS softfp lays them out.
+class HostGles1::Args {
+public:
+    Args(LibraryRuntime& runtime, GuestThread& thread)
+        : runtime_(runtime), thread_(thread),
+          regs_{thread.regs()[0], thread.regs()[1], thread.regs()[2], thread.regs()[3]} {
+        thread_.regs()[0] = 0;
+        thread_.regs()[1] = 0;
+    }
+
+    std::uint32_t word(unsigned position) {
+        if (position < 4) return regs_[position];
+        const std::uint64_t address = static_cast<std::uint64_t>(thread_.regs()[13]) + 4u * (position - 4u);
+        const std::uint8_t* source = address > UINT32_MAX ? nullptr :
+            runtime_.memory().host_ptr(static_cast<std::uint32_t>(address), 4, kPageRead);
+        if (source == nullptr) return 0;
+        std::uint32_t value;
+        std::memcpy(&value, source, sizeof value);
+        return value;
+    }
+
+    float f(unsigned position) { return std::bit_cast<float>(word(position)); }
+
+    // A guest address inside the 4 GiB reservation; the whole space is mapped on the host.
+    void* pointer(unsigned position) {
+        const std::uint32_t address = word(position);
+        if (address == 0) return nullptr;
+        return runtime_.memory().base() + address;
+    }
+
+    // glVertexPointer and friends: an offset into the bound GL_ARRAY_BUFFER, else a client array.
+    void* array_pointer(unsigned position) {
+        static const auto get_integerv = gles1_fn<void(GL_APIENTRY*)(GLenum, GLint*)>("glGetIntegerv");
+        GLint bound = 0;
+        if (get_integerv != nullptr) get_integerv(kArrayBufferBinding, &bound);
+        if (bound != 0) return reinterpret_cast<void*>(static_cast<std::uintptr_t>(word(position)));
+        return pointer(position);
+    }
+
+    void result(std::uint32_t value) { thread_.regs()[0] = value; }
+
+    LibraryRuntime& runtime() { return runtime_; }
+
+private:
+    LibraryRuntime& runtime_;
+    GuestThread& thread_;
+    std::uint32_t regs_[4];
+};
+
+void* HostGles1::entry(unsigned slot, const char* name) {
+    if (slot >= sizeof entries_ / sizeof entries_[0]) return nullptr;
+    void* cached = entries_[slot].load(std::memory_order_acquire);
+    if (cached == nullptr) {
+        void* handle = gles1_library();
+        cached = handle != nullptr ? ::dlsym(handle, name) : nullptr;
+        if (cached == nullptr) cached = reinterpret_cast<void*>(::eglGetProcAddress(name));
+        if (cached == nullptr) cached = kMissing;
+        entries_[slot].store(cached, std::memory_order_release);
+    }
+    return cached == kMissing ? nullptr : cached;
+}
+
+bool HostGles1::missing(Args&, const char* name) {
+    runtime_report().note_unimplemented_host_call(0, "libGLESv1_CM.so", name);
+    return true;
+}
+
+// glGetPointerv writes a pointer: report it back as a guest address (or the raw buffer offset).
+bool HostGles1::glGetPointerv_manual(Args& a) {
+    const GLenum pname = static_cast<GLenum>(a.word(0));
+    const std::uint32_t out = a.word(1);
+    static const auto get_pointerv = gles1_fn<void(GL_APIENTRY*)(GLenum, void**)>("glGetPointerv");
+    void* value = nullptr;
+    if (get_pointerv != nullptr) get_pointerv(pname, &value);
+    const std::uintptr_t host = reinterpret_cast<std::uintptr_t>(value);
+    const std::uintptr_t base = reinterpret_cast<std::uintptr_t>(a.runtime().memory().base());
+    std::uint32_t guest = static_cast<std::uint32_t>(host);
+    if (host >= base && host - base <= UINT32_MAX) guest = static_cast<std::uint32_t>(host - base);
+    std::uint8_t* target = a.runtime().memory().host_ptr(out, 4, kPageWrite);
+    if (target != nullptr) std::memcpy(target, &guest, sizeof guest);
+    return true;
+}
+
+#include "gen/gles1_dispatch.inc"
+
+bool HostGles1::handle_host_call(std::uint32_t index, GuestThread& thread) {
+    if (index < kGles1First || index > kGles1Last) return false;
+    Args args(runtime_, thread);
+    if (dispatch(index, args)) return true;
+    return false;
+}
+
+}  // namespace zb
