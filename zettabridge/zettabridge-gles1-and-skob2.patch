diff --git a/tools/gen_gles1.py b/tools/gen_gles1.py
new file mode 100644
index 0000000..cf9af20
--- /dev/null
+++ b/tools/gen_gles1.py
@@ -0,0 +1,108 @@
+#!/usr/bin/env python3
+"""Generate the GLES 1.1 host-call dispatcher (core/src/gen/gles1_dispatch.inc).
+
+Covers every libGLESv1_CM.so row of core/src/gen/hostcalls.inc, that is the GLES 1.1 entry
+points GLES 2 does not share (shared names already go to HostGl) plus the OES extensions in
+gen_stubs.gles1_oes_names(). Signatures come from the NDK GLES/gl.h and GLES/glext.h.
+
+GLES 1.1 has no 64-bit parameters, so every argument is one 32-bit word (AAPCS softfp puts
+floats in core registers). A pointer argument is a guest address inside the 4 GiB guest
+reservation and becomes base + address on the host; 0 stays NULL. The array-pointer calls
+(glVertexPointer and friends) take a buffer offset instead while GL_ARRAY_BUFFER is bound, so
+the dispatcher leaves the value untouched then. glGetPointerv writes a pointer and is handled
+by hand in host_gles1.cpp.
+"""
+import os
+import re
+import sys
+
+sys.dont_write_bytecode = True
+import gen_stubs
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+HOSTCALLS = os.path.join(ROOT, "core", "src", "gen", "hostcalls.inc")
+OUT = os.path.join(ROOT, "core", "src", "gen", "gles1_dispatch.inc")
+
+ARRAY_POINTER_CALLS = {
+    "glVertexPointer", "glColorPointer", "glNormalPointer", "glTexCoordPointer",
+    "glPointSizePointerOES", "glMatrixIndexPointerOES", "glWeightPointerOES",
+}
+HANDWRITTEN = {"glGetPointerv"}
+FLOAT_TYPES = {"GLfloat", "GLclampf"}
+INT_TYPES = {"GLenum", "GLboolean", "GLbitfield", "GLbyte", "GLshort", "GLint", "GLsizei",
+             "GLubyte", "GLushort", "GLuint", "GLfixed", "GLclampx"}
+RESULT_TYPES = {"void"} | INT_TYPES
+
+
+def prototypes():
+    text = ""
+    for header in ("gl.h", "glext.h"):
+        text += open(os.path.join(gen_stubs.INCLUDE, "GLES", header)).read()
+    found = {}
+    for match in re.finditer(r"GL_API\s+([\w ]+?)\s*\bGL_APIENTRY\s+(gl\w+)\s*\(([^)]*)\)\s*;", text):
+        found.setdefault(match.group(2), (match.group(1).strip(), match.group(3).strip()))
+    return found
+
+
+def parse_parameter(text):
+    text = " ".join(text.split())
+    match = re.fullmatch(r"(.*?)(\w+)", text)
+    declaration, name = match.group(1).strip(), match.group(2)
+    pointer = "*" in declaration
+    base = declaration.replace("const", "").replace("*", "").strip()
+    return declaration, name, pointer, base
+
+
+def main():
+    rows = [(int(i), n) for i, lib, n in
+            re.findall(r'\{(\d+), "([^"]+)", "(\w+)"\}', open(HOSTCALLS).read()) if lib == "libGLESv1_CM.so"]
+    protos = prototypes()
+    lines = ["// Generated by tools/gen_gles1.py. Do not edit.", ""]
+    first = min(i for i, _ in rows)
+    last = max(i for i, _ in rows)
+    lines += ["inline constexpr std::uint32_t kGles1First = %d;" % first,
+              "inline constexpr std::uint32_t kGles1Last = %d;" % last, "",
+              "bool HostGles1::dispatch(std::uint32_t index, Args& a) {",
+              "    switch (index) {"]
+    for index, name in rows:
+        if name in HANDWRITTEN:
+            lines += ["    case %d: return %s_manual(a);" % (index, name)]
+            continue
+        if name not in protos:
+            sys.exit("no prototype for " + name)
+        result, params = protos[name]
+        if result not in RESULT_TYPES:
+            sys.exit("%s: unsupported result type %s" % (name, result))
+        parsed = [] if params in ("", "void") else [parse_parameter(p) for p in params.split(",")]
+        types, values = [], []
+        for position, (declaration, pname, pointer, base) in enumerate(parsed):
+            types.append(declaration)
+            if pointer:
+                if name in ARRAY_POINTER_CALLS:
+                    values.append("reinterpret_cast<%s>(a.array_pointer(%d))" % (declaration, position))
+                else:
+                    values.append("reinterpret_cast<%s>(a.pointer(%d))" % (declaration, position))
+            elif base in FLOAT_TYPES:
+                values.append("a.f(%d)" % position)
+            elif base in INT_TYPES:
+                values.append("static_cast<%s>(a.word(%d))" % (base, position))
+            else:
+                sys.exit("%s: unsupported parameter %s" % (name, declaration))
+        fn = "reinterpret_cast<%s(GL_APIENTRY*)(%s)>(entry(%d, \"%s\"))" % (
+            result, ", ".join(types) or "void", index - first, name)
+        call = "%s(%s)" % (fn, ", ".join(values))
+        lines.append("    case %d: {  // %s" % (index, name))
+        lines.append("        if (entry(%d, \"%s\") == nullptr) return missing(a, \"%s\");" % (index - first, name, name))
+        if result == "void":
+            lines.append("        %s;" % call)
+        else:
+            lines.append("        a.result(static_cast<std::uint32_t>(%s));" % call)
+        lines.append("        return true;")
+        lines.append("    }")
+    lines += ["    default: return false;", "    }", "}", ""]
+    open(OUT, "w").write("\n".join(lines))
+    print("gles1: %d host calls (%d-%d)" % (len(rows), first, last))
+
+
+if __name__ == "__main__":
+    main()
