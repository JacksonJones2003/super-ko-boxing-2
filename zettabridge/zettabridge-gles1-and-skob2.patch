+        "glLoadPaletteFromModelViewMatrixOES", "glMatrixIndexPointerOES",
+        "glRenderbufferStorageOES", "glWeightPointerOES",
+    ])
+
+
 LIBRARIES = [
     ("libGLESv2", gles2_names),
     ("libandroid", android_names),
@@ -235,6 +253,8 @@ LIBRARIES = [
     ("libandroid", looper_pollall_names),
     # GLES 1.1: linked by Unity 4.5, so the library has to exist for the guest to load at all.
     ("libGLESv1_CM", gles1_names),
+    # GLES 1.1 OES extensions, appended after the core GLES 1.1 names for the same reason.
