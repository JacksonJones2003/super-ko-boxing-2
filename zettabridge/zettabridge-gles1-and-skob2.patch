diff --git a/core/include/zb/host_gles1.h b/core/include/zb/host_gles1.h
new file mode 100644
index 0000000..9612e6d
--- /dev/null
+++ b/core/include/zb/host_gles1.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+#include "zb/guest_thread.h"
+#include "zb/library_runtime.h"
+
+namespace zb {
+
+// GLES 1.1 passthrough (Android only): the entry points libGLESv1_CM.so exports and GLES 2 does
+// not, plus the OES extensions of gen_stubs.gles1_oes_names(). Shared names (glBindTexture,
+// glDrawArrays, ...) keep going to HostGl. The guest renders into the context its Java
+// GLSurfaceView made current on GLThread, so every call goes straight to the host driver.
+class HostGles1 {
+public:
+    explicit HostGles1(LibraryRuntime& runtime) : runtime_(runtime) {}
+
+    bool handle_host_call(std::uint32_t index, GuestThread& thread);
+
+    class Args;
+
+private:
+    bool dispatch(std::uint32_t index, Args& a);
+    bool glGetPointerv_manual(Args& a);
+    bool missing(Args& a, const char* name);
+    void* entry(unsigned slot, const char* name);
+
+    LibraryRuntime& runtime_;
+    std::atomic<void*> entries_[128] = {};
+};
+
+}  // namespace zb
